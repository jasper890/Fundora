# Local Supabase (npx supabase start) — never commit real values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
AUTH_THROTTLE_SECRET=replace-with-long-random
CRON_SECRET=replace-with-long-random
STELLAR_ALLOW_SUBMISSION=0
STELLAR_USE_FAKE_RPC=1
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# SHA-256 of installed award WASM on Testnet (stellar contract upload)
STELLAR_WASM_HASH=
# Hard-capped by FEE_CEILING in code (100_000_000). Soroban deploy needs >> classic 10M.
STELLAR_MAX_FEE=100000000
SEED_PASSWORD=ProofPay-Demo-Password-12
# Optional: override synthetic wallets with Freighter Testnet public keys
# SEED_SPONSOR_WALLET=
# SEED_VERIFIER_WALLET=
# SEED_RECIPIENT_01_WALLET=
