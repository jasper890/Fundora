{
  "expo": {
    "name": "Fundora",
    "slug": "fundora",
    "version": "0.1.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fundora",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.fundora.app",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.fundora.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFF8E7",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF8E7",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#10231E",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Fundora uses the camera to photograph evidence for your award. Photos upload privately and are not saved to your gallery.",
          "photosPermission": "Fundora lets you choose existing photos as evidence for your award.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Fundora uses Face ID to unlock the app and to sign Testnet transactions with your phone wallet."
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "28f8d2c2-8454-42b5-a4fd-8294587cf44f"
      }
    },
    "owner": "jasperngo890",
    "updates": {
      "url": "https://u.expo.dev/28f8d2c2-8454-42b5-a4fd-8294587cf44f"
    }
  }
}
