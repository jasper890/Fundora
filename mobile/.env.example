# Copy to .env.local. EXPO_PUBLIC_* values ship inside the app bundle: never put a secret here.
# Fundora web origin that serves /api/v1 (it must run with MOBILE_BEARER_AUTH=1). A phone cannot reach
# 127.0.0.1: use the hosted preview or your laptop's LAN address.
EXPO_PUBLIC_API_BASE_URL=https://fundora-instaward.vercel.app
# Web origin opened by "Continue on web" for wallet signing (defaults to the API origin).
EXPO_PUBLIC_WEB_BASE_URL=https://fundora-instaward.vercel.app
